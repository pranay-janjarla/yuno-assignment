# ── AI Provider ───────────────────────────────────────────────────────────────
# Required. Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ── Telegram ──────────────────────────────────────────────────────────────────
# Required for the Telegram bot. Get from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=...
TELEGRAM_BOT_USERNAME=your_bot_username
# Your personal Telegram chat ID (for approval messages). Find it via @userinfobot.
TELEGRAM_APPROVAL_CHAT_ID=...

# ── Web Search ────────────────────────────────────────────────────────────────
# Optional. Get from https://app.tavily.com
TAVILY_API_KEY=tvly-...

# ── API Security ──────────────────────────────────────────────────────────────
# Set to a random string (e.g. openssl rand -hex 32).
# Protects /api/credentials and /api/webhooks endpoints.
# Set the same value in Railway. If left empty, auth is skipped (local dev only).
API_SECRET_KEY=change-this-to-a-random-string

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Add your Netlify URL here for production.
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.netlify.app

# ── Backend URL ───────────────────────────────────────────────────────────────
# Used by the Telegram bot to call the FastAPI backend.
# Set to your Railway backend URL in production.
API_BASE_URL=http://localhost:8000
